# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Ruff
.ruff_cache/

# Local application state and locks
state.json*
*.lock

# Vendored libraries (vendor/)
# vendor/python-espncricinfo is committed as plain source. Its own .gitignore
# (kept from upstream) already skips caches, .venv and build output inside it.
# Keep upstream's lockfile, which the "*.lock" rule above would otherwise drop
# (that rule is meant for the tracker's state lock files).
!vendor/*/uv.lock
# Local tool and editor state that should never be committed with vendored code.
vendor/**/.claude/
vendor/**/.idea/
vendor/**/.vscode/
vendor/**/.coverage
vendor/**/htmlcov/
